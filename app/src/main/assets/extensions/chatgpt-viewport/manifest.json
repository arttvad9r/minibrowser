{
  "manifest_version": 3,
  "name": "Minibrowser ChatGPT viewport compatibility",
  "version": "1.0.1",
  "description": "Keeps ChatGPT's layout viewport resized with the Android software keyboard.",
  "browser_specific_settings": {
    "gecko": {
      "id": "chatgpt-viewport@minibrowser"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": [
        "viewport.js"
      ],
      "run_at": "document_start"
    }
  ]
}
